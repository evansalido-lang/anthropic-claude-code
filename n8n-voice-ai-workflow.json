{
  "name": "ElevenLabs Voice Agent - RAG Knowledge Base",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "elevenlabs-voice-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-entry",
      "name": "ElevenLabs Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "elevenlabs-voice-agent"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Extract data from ElevenLabs Conversational AI webhook\n// ElevenLabs sends the caller's transcribed speech\nconst webhookData = $input.first().json.body;\n\n// ElevenLabs webhook payload structure\nconst query = webhookData.text || webhookData.transcript || webhookData.message || '';\nconst conversation_id = webhookData.conversation_id || webhookData.call_id || 'default';\nconst caller_id = webhookData.caller_id || webhookData.from || 'anonymous';\n\n// Log for debugging\nconsole.log('Received query:', query);\nconsole.log('Conversation ID:', conversation_id);\n\nreturn [{\n  json: {\n    query: query,\n    conversation_id: conversation_id,\n    caller_id: caller_id\n  }\n}];"
      },
      "id": "extract-elevenlabs-data",
      "name": "Extract Caller Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.query }}",
        "options": {
          "systemMessage": "You are a helpful voice assistant answering phone calls. Your responses will be spoken aloud to callers.\n\nIMPORTANT GUIDELINES:\n- ALWAYS use the knowledge_base tool to search for relevant information before answering\n- Keep responses concise and conversational (2-3 sentences max)\n- Speak naturally as if talking on the phone\n- Avoid technical jargon, bullet points, or formatting\n- If you can't find relevant information, politely say you don't have that information\n- Be friendly and professional"
        }
      },
      "id": "ai-agent",
      "name": "Generate Answer from Knowledge Base",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [440, 0]
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "options": {
          "temperature": 0.7
        }
      },
      "id": "google-gemini",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [340, 220],
      "credentials": {
        "googleGeminiApi": {
          "id": "your-gemini-credential-id",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "qdrantCollection": {
          "__rl": true,
          "mode": "list",
          "value": "your-collection-name"
        },
        "options": {}
      },
      "id": "qdrant-vector-store",
      "name": "Qdrant Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1,
      "position": [640, 400],
      "credentials": {
        "qdrantApi": {
          "id": "your-qdrant-credential-id",
          "name": "Qdrant API"
        }
      }
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "openai-embeddings",
      "name": "OpenAI Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [640, 560],
      "credentials": {
        "openAiApi": {
          "id": "your-openai-credential-id",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "name": "knowledge_base",
        "description": "Search the knowledge base for information to answer caller questions. Always use this tool before responding to find accurate information.",
        "topK": 5
      },
      "id": "vector-store-tool",
      "name": "Vector Store Tool",
      "type": "@n8n/n8n-nodes-langchain.toolVectorStore",
      "typeVersion": 1,
      "position": [540, 220]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.conversation_id }}"
      },
      "id": "window-buffer-memory",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [440, 220]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Format response for ElevenLabs Conversational AI\nconst aiResponse = $input.first().json.output;\n\n// ElevenLabs expects a JSON response with the text to speak\nreturn [{\n  json: {\n    response: aiResponse,\n    text: aiResponse\n  }\n}];"
      },
      "id": "format-response",
      "name": "Format Response for ElevenLabs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "respond-to-elevenlabs",
      "name": "Respond to ElevenLabs",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 0]
    }
  ],
