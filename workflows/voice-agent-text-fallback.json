{
  "name": "Voice Agent - Claude + Eleven Labs (with Text Fallback)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-agent-v2",
        "options": {
          "rawBody": true
        },
        "responseMode": "responseNode"
      },
      "id": "webhook-trigger",
      "name": "Voice Agent Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "voice-agent-v2-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-has-audio",
              "leftValue": "={{ $binary?.audio }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-input-type",
      "name": "Audio or Text Input?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "transcribe",
        "binaryPropertyName": "audio",
        "options": {
          "language": "en",
          "responseFormat": "text"
        }
      },
      "id": "speech-to-text",
      "name": "Speech to Text (Whisper)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.6,
      "position": [680, 200],
      "credentials": {
        "openAiApi": {
          "id": "openai-credentials",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "text",
              "value": "={{ $json.body?.message || $json.body?.text || $json.body?.query || 'Hello, how can I help you?' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-text-input",
      "name": "Extract Text Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 400]
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": {
          "values": []
        },
        "options": {}
      },
      "id": "merge-inputs",
      "name": "Merge Inputs",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-20250514"
        },
        "messages": {
          "values": [
            {
              "content": "={{ $json.text }}"
            }
          ]
        },
        "options": {
          "systemMessage": "You are a helpful, friendly, and conversational voice assistant. Your responses should be:\n\n1. **Concise**: Keep responses brief and to the point since they will be spoken aloud. Aim for 1-3 sentences unless more detail is specifically requested.\n\n2. **Natural**: Use conversational language that sounds natural when spoken. Avoid bullet points, markdown formatting, or text-only constructs.\n\n3. **Engaging**: Be warm, personable, and engaging. Use a friendly tone that makes the conversation enjoyable.\n\n4. **Clear**: Avoid jargon, complex vocabulary, or tongue-twisters that might be difficult to pronounce or understand when spoken.\n\n5. **Contextual**: Remember the conversation context and refer back to previous points when relevant.\n\nRespond as if you're having a natural voice conversation with a friend. Never mention that you're an AI unless directly asked.",
          "maxTokens": 500,
          "temperature": 0.7
        }
      },
      "id": "claude-brain",
      "name": "Claude AI Brain",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.2,
      "position": [1120, 300],
      "credentials": {
        "anthropicApi": {
          "id": "anthropic-credentials",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "want-audio-response",
              "leftValue": "={{ $('Voice Agent Webhook').item.json.headers['x-response-format'] }}",
              "rightValue": "text",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-response-format",
      "name": "Audio or Text Response?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "resource": "textToSpeech",
        "voiceId": {
          "__rl": true,
          "mode": "list",
          "value": "21m00Tcm4TlvDq8ikWAM",
          "cachedResultName": "Rachel"
        },
        "text": "={{ $json.message.content }}",
        "options": {
          "modelId": "eleven_multilingual_v2",
          "stability": 0.5,
          "similarityBoost": 0.75,
          "style": 0.5,
          "useSpeakerBoost": true,
          "outputFormat": "mp3_44100_128"
        }
      },
      "id": "eleven-labs-tts",
      "name": "Eleven Labs TTS",
      "type": "n8n-nodes-base.elevenLabs",
      "typeVersion": 1,
      "position": [1560, 200],
      "credentials": {
        "elevenLabsApi": {
          "id": "elevenlabs-credentials",
          "name": "Eleven Labs API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseBody": "={{ $binary }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "audio/mpeg"
              }
            ]
          }
        }
      },
      "id": "respond-audio",
      "name": "Respond with Audio",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ response: $json.message.content, model: 'claude-sonnet-4-20250514', timestamp: $now.toISO() }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "respond-text",
      "name": "Respond with Text",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1560, 400]
    }
  ],
